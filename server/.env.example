# MongoDB connection string
# Get this from MongoDB Atlas: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/acreprofit?retryWrites=true&w=majority

# JWT Secret for authentication (use a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Port (Render will set this automatically)
PORT=3001

# Printify Integration (for automated merch fulfillment)
# Get these from your Printify account: https://printify.com/app/account/api
PRINTIFY_API_KEY=your-printify-api-key
PRINTIFY_SHOP_ID=your-printify-shop-id

# Stripe Connect (for payment processing)
# Get these from your Stripe dashboard: https://dashboard.stripe.com/apikeys
# Each representative will connect their own Stripe account via Connect
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Frontend URL (for Stripe Connect redirects and password reset links)
FRONTEND_URL=https://acreprofit.com

# Email Configuration (for password reset emails)
# Microsoft 365 / Outlook
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@acreprofit.com
SMTP_PASS=your-outlook-password-or-app-password

# Email sender address (must match SMTP_USER for Office 365)
EMAIL_FROM=contact@acreprofit.com

# Alternative: Gmail (use App Password if 2FA enabled)
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-app-password

# Alternative: SendGrid, Mailgun, etc.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-api-key

# ============ Microsoft Graph API (SharePoint/Excel Price Sync) ============
# Register an app at https://portal.azure.com > Azure Active Directory > App registrations
# Grant permissions: Files.Read.All, Sites.Read.All (Application permissions)
# Create a client secret and add the values below

MICROSOFT_CLIENT_ID=your-azure-ad-client-id
MICROSOFT_CLIENT_SECRET=your-azure-ad-client-secret
MICROSOFT_TENANT_ID=your-azure-ad-tenant-id

# SharePoint site and file info
# From the shared link: https://netorgft15418687-my.sharepoint.com/:x:/g/personal/jeff_cropprotectdirect_com/...
SHAREPOINT_SITE_ID=netorgft15418687-my.sharepoint.com
SHAREPOINT_DRIVE_ID=auto-detected-on-first-sync
SHAREPOINT_FILE_PATH=/personal/jeff_cropprotectdirect_com/Documents/price-list.xlsx

# Price sync schedule (cron format, default: every 6 hours)
PRICE_SYNC_CRON=0 */6 * * *
